{
  "name": "coleccion",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "wasm": "cp node_modules/sql.js/dist/sql-wasm.wasm public/assets/",
    "predev": "npm run wasm",
    "prebuild": "npm run wasm",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "assets": "node scripts/assets/generate.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/vue": "^9.0.6",
    "@ionic/vue-router": "^9.0.6",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "sharp": "^0.35.5",
    "sql.js": "^1.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
